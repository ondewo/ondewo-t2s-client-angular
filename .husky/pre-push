#!/bin/sh

# Local equivalent of the CI gate: run every spec and enforce the 100% coverage
# threshold on the hand-written sources (src/lib/auth + src/examples) before anything
# leaves this machine. `npm test` is `jest --config jest.config.js`, and jest.config.js
# sets `collectCoverage: true` plus the 100% `coverageThreshold`, so the gate runs even
# without an explicit --coverage flag.
#
# This lives on pre-push and deliberately NOT in .husky/pre-commit:
# `make run_precommit_hooks` executes .husky/pre-commit DIRECTLY and `make release` calls it,
# so `npm test` in pre-commit would run the full coverage gate inside the automated release —
# right after the codegen has rewritten api/ and package.json.
set -e
npm test
